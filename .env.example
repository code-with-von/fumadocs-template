# --------------------------------------------------------------------------------------------------
# NOTE from @vonschappler
# - do not change the names of the variables
# - any changes on this file, should be done after the "=" sign, by pasting the values provided by the 3rd party applications used to properly connect this project to them
# --------------------------------------------------------------------------------------------------

# --------------------------------------------------------------------------------------------------
# Posthog settings
# Those values should be obtained from your own Posthog project dashboard, so you need to have a Posthog account and get those values from a project you create there
# --------------------------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=


# --------------------------------------------------------------------------------------------------
# Spotify settings
# This is the URL generated by https://spotify-github-profile.kittinanx.com after you successfully connect your account to this application
# --------------------------------------------------------------------------------------------------
NEXT_PUBLIC_SPOTIFY_URL=
