  "biome.runFromTemporaryLocation": false,
  "biome.requireConfiguration": true,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "better-todo-tree.general.tags": [
    "APPLIED_LINT_RULE",
    "BUG",
    "CONSOLIDATION",
    "DOCS_ADD",
    "DOCS_UPD",
    "FEATURE_REQUEST",
    "FIXME",
    "HACK",
    "INFO",
    "ISSUE",
    "NOTE",
    "SUGGESTION",
    "TODO",
    "[ ]", // planned or in-progress TODOs
    "[x]" // completed TODOs
  ],
  "better-todo-tree.highlights.defaultHighlight": {
    "gutterIcon": true
  },
  "better-todo-tree.highlights.customHighlight": {
    "APPLIED_LINT_RULE": {
      "icon": "search",
      "iconColour": "#f00",
      "background": "#f00",
      "foreground": "#fff"
    },
    "CONSOLIDATION": {
      "icon": "alert",
      "iconColour": "#f00",
      "background": "#f00",
      "foreground": "#fff"
    },
    "DOCS_ADD": {
      "icon": "book",
      "iconColour": "#0dd",
      "background": "#0dd",
      "foreground": "#fff"
    },
    "DOCS_UPD": {
      "icon": "book",
      "iconColour": "#ddd",
      "background": "#ddd",
      "foreground": "#000"
    },
    "FEATURE_REQUEST": {
      "icon": "eye",
      "iconColour": "#fc5",
      "background": "#fc5",
      "foreground": "#000"
    },
    "FIXME": {
      "iconColour": "#f55",
      "background": "#f55",
      "foreground": "#000"
    },
    "HACK": {
      "iconColour": "#05f",
      "background": "#05f",
      "foreground": "#fff"
    },
    "INFO": {
      "icon": "info",
      "iconColour": "#a0f",
      "background": "#a0f",
      "foreground": "#fff"
    },
    "NOTE": {
      "icon": "eye",
      "iconColour": "#0a0",
      "background": "#0a0",
      "foreground": "#fff"
    },
    "SUGGESTION": {
      "icon": "alert",
      "iconColour": "#55f",
      "background": "#55f",
      "foreground": "#fff"
    },
    "TODO": {
      "iconColour": "#050",
      "background": "#050",
      "foreground": "#fff"
    },
    "[ ]": {
      "iconColour": "#c00",
      "background": "#c00",
      "foreground": "#fff"
    },
    "[x]": {
      "iconColour": "#0a0",
      "background": "#0a0",
      "foreground": "#fff"
    }
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true
  }
}
