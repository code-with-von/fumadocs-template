{
  "name": "fumadocs-template",
  "description": "A Fumadocs template for generic use, with some additional plugins and custom components, created by @vonschappler",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "fumadocs-mdx && next build",
    "dev": "next dev --port 5000",
    "start": "next start --port 5001",
    "inf:init": "infisical init",
    "inf:dev": "infisical run -- pnpm dev",
    "inf:build": "infisical run -- pnpm build",
    "inf:start": "infisical run -- pnpm start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@fuma-translate/react": "1.0.2",
    "@fumadocs/story": "1.3.0",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-tabs": "1.1.21",
    "@shikijs/twoslash": "4.5.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "cnfast": "0.2.0",
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.11",
    "fumadocs-openapi": "10.10.3",
    "fumadocs-twoslash": "4.0.0",
    "fumadocs-typescript": "5.4.0",
    "fumadocs-ui": "16.9.3",
    "katex": "0.18.6",
    "lucide-react": "1.41.0",
    "mermaid": "11.17.2",
    "motion": "13.2.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "posthog-js": "1.427.2",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "shadcn": "4.21.0",
    "shiki": "4.4.3",
    "tw-animate-css": "1.4.0",
    "twoslash": "0.3.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@infisical/cli": "0.44.15",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "postcss": "8.5.28",
    "react-medium-image-zoom": "5.4.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "uuid": "14.0.2"
  },
  "author": {
    "name": "von Schappler (Manoel Viturino)",
    "email": "dev_vonschappler@outlook.com",
    "url": "https://vonschappler.github.io"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
